# Runtime backend: cpu, vulkan, cuda.
WHISPER_BACKEND=cpu

# Pinned upstream whisper.cpp container build.
WHISPER_CPP_REF=afa2ea544fb4b0448916b4a31ecd33c8685bd482

# Host bind address and port. Keep 127.0.0.1 for local-only access; use 0.0.0.0 for LAN testing.
WHISPER_HOST=127.0.0.1
WHISPER_PORT=2022

# Model name used by whisper.cpp download scripts.
# Good options: base, small, medium, large-v3, large-v3-turbo.
WHISPER_MODEL=large-v3-turbo

# Optional model quantization suffix. Empty means original/unquantized model file.
# Good options: q8_0, q5_0. Some smaller models also provide q5_1.
WHISPER_QUANT=

# Runtime tuning.
WHISPER_PROCESSORS=1
WHISPER_THREADS=4
