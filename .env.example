# Runtime backend: cpu, vulkan, cuda.
WHISPER_BACKEND=cpu

# Host bind address and port. Keep 127.0.0.1 for local-only access; use 0.0.0.0 for LAN testing.
WHISPER_HOST=127.0.0.1
WHISPER_PORT=2022

# Model name used by whisper.cpp download scripts.
# Good options: base, small, medium, large-v3, large-v3-turbo.
WHISPER_MODEL=large-v3-turbo

# Model quantization suffix. Use none for the original/unquantized model file.
# Good options: none, q8_0, q5_0. Some smaller models also provide q5_1.
WHISPER_QUANT=none

# Runtime tuning.
WHISPER_PROCESSORS=1
WHISPER_THREADS=4
