# Backend: cpu, vulkan, cuda. CPU works on most Linux hosts; Vulkan covers AMD/Intel GPUs;
# CUDA covers NVIDIA hosts with the NVIDIA Container Toolkit.
WHISPER_BACKEND=cpu

# Bind host address/port. Keep 127.0.0.1 for homelab safety.
WHISPER_BIND_ADDR=127.0.0.1
WHISPER_HOST_PORT=2022
WHISPER_CONTAINER_PORT=2022

# Docker images for each backend.
WHISPER_CPU_IMAGE=ghcr.io/ggml-org/whisper.cpp:main
WHISPER_VULKAN_IMAGE=ghcr.io/ggml-org/whisper.cpp:main-vulkan
WHISPER_CUDA_IMAGE=ghcr.io/ggml-org/whisper.cpp:main-cuda

# Model download name. Good defaults: base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=small
WHISPER_MODEL_FILE=ggml-small.bin

# Runtime tuning. Keep processors=1 for voice-agent latency stability.
WHISPER_PROCESSORS=1
WHISPER_THREADS=4
WHISPER_INFERENCE_PATH=/v1/audio/transcriptions

# Vulkan backend settings.
WHISPER_DRI_DEVICE=/dev/dri

# CUDA backend settings.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
NVIDIA_GPU_COUNT=all

# Adapter/client defaults.
WHISPER_BASE_URL=http://127.0.0.1:2022
WHISPER_LANGUAGE=
WHISPER_TIMEOUT=30
