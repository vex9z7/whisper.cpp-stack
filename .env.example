# Runtime backend: cpu, vulkan, cuda.
WHISPER_BACKEND=cpu

# Host port. Service binds to 127.0.0.1 for safety.
WHISPER_PORT=2022

# Model name used by whisper.cpp download scripts.
# Good options: base, small, medium, large-v3, large-v3-turbo.
WHISPER_MODEL=large-v3-turbo

# Runtime tuning.
WHISPER_PROCESSORS=1
WHISPER_THREADS=4
